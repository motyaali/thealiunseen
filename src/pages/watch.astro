---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Watch" description="Live streams and video from The Ali Unseen.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Watch</div>
      <h1 class="page-title">Learning, building, and thinking out loud.</h1>
      <p class="lede">The video side of The Ali Unseen is for live experiments, coding, AI exploration, learning in public, and conversations that make the process visible instead of presenting only the polished result.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <div class="card featured signal">
        <div>
          <div class="kicker">Twitch</div>
          <h3>The live channel</h3>
          <p>The Twitch presence is being connected to this site. Once the public channel URL is confirmed, this card will link directly to live streams and the channel archive.</p>
        </div>
        <div class="meta">Live link coming next.</div>
      </div>
      <div class="card side">
        <div>
          <div class="kicker">What to expect</div>
          <h3>Process over performance</h3>
          <p>AI, coding, experiments, school, creative work, and whatever is interesting enough to investigate in real time.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
