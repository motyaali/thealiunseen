---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About The Ali Unseen, a human-centered space for writing, technology, AI, and lived experience.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">About</div>
      <h1 class="page-title">A human-centered view of intelligent systems.</h1>
      <p class="lede">The Ali Unseen is a place to examine the parts of technology that are easy to miss: the human context, the hidden friction, the decisions between inputs and outcomes, and the lived experience behind every system.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <div class="card featured">
        <div>
          <div class="kicker">The idea</div>
          <h3>Technology is never only technical.</h3>
          <p>AI can summarize, classify, generate, predict, and automate. But people still live with the consequences. The Ali Unseen focuses on that intersection, where tools meet memory, work, education, creativity, bureaucracy, identity, and everyday life.</p>
        </div>
      </div>
      <div class="card side">
        <div>
          <div class="kicker">The approach</div>
          <h3>Observe. Question. Build. Reflect.</h3>
          <p>Some ideas become essays. Others become prototypes. The common thread is curiosity paired with practical experimentation.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Themes</div>
          <h2>What belongs here</h2>
        </div>
      </div>
      <div class="pill-list">
        <span class="pill">Human + AI</span>
        <span class="pill">Technology</span>
        <span class="pill">Systems</span>
        <span class="pill">Learning</span>
        <span class="pill">Creativity</span>
        <span class="pill">Accessibility</span>
        <span class="pill">Experiments</span>
        <span class="pill">Lived experience</span>
      </div>
    </div>
  </section>
</BaseLayout>
