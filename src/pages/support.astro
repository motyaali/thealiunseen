---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support" description="Support and follow The Ali Unseen.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Support</div>
      <h1 class="page-title">Help make room for independent work.</h1>
      <p class="lede">The Ali Unseen is being built as an independent home for writing, experiments, and public learning. If you want to support the work, there are a few simple ways to do it.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <a class="card featured signal" href="https://ko-fi.com/thealiunseen" target="_blank" rel="noreferrer">
        <div>
          <div class="kicker">Ko-fi</div>
          <h3>Support the work directly</h3>
          <p>One-time support helps cover the tools, hosting, experiments, and time required to keep building and publishing.</p>
        </div>
        <div class="meta">ko-fi.com/thealiunseen →</div>
      </a>
      <a class="card side" href="https://substack.com/@thealiunseen" target="_blank" rel="noreferrer">
        <div>
          <div class="kicker">Newsletter</div>
          <h3>Subscribe on Substack</h3>
          <p>Follow new writing while the independent site archive grows.</p>
        </div>
        <div class="meta">@thealiunseen →</div>
      </a>
    </div>
  </section>
</BaseLayout>
