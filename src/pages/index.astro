---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-copy">
      <div class="eyebrow">Human × AI</div>
      <h1 class="glitch-title"><span class="small">The Ali</span>Unseen</h1>
      <p class="hero-dek">Human experience. Artificial intelligence. Everything in between. Writing, experiments, technology, and the systems we build to make a complicated world more understandable.</p>
      <div class="hero-actions">
        <a class="button primary" href="/writing/">Read the writing</a>
        <a class="button" href="/about/">Start here</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Latest signal</div>
          <h2>From The Unseen</h2>
        </div>
        <a class="button" href="/writing/">View all writing</a>
      </div>

      <div class="grid">
        <a class="card featured signal" href="/writing/start-here/">
          <div>
            <div class="kicker">Start here</div>
            <h3>What is The Ali Unseen?</h3>
            <p>A home for examining what happens when lived experience, technology, artificial intelligence, and human judgment collide.</p>
          </div>
          <div class="meta">Read the introduction →</div>
        </a>

        <div class="card side">
          <div>
            <div class="kicker">Newsletter</div>
            <h3>Follow the writing</h3>
            <p>The newsletter currently lives on Substack while this independent home grows around it.</p>
          </div>
          <a class="button" href="https://substack.com/@thealiunseen" target="_blank" rel="noreferrer">Open Substack</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Explore</div>
          <h2>Ideas with somewhere to go</h2>
          <p class="section-intro">The Ali Unseen is built to hold more than one kind of work. These are the lanes that connect the writing, projects, and experiments.</p>
        </div>
      </div>

      <div class="grid">
        <a class="card" href="/writing/">
          <div><div class="kicker">Writing</div><h3>Human + AI</h3><p>Essays and reflections on how people use intelligent systems, and how those systems change the way we think and act.</p></div>
          <div class="meta">Essays and notes</div>
        </a>
        <a class="card" href="/projects/">
          <div><div class="kicker">Projects</div><h3>Build in public</h3><p>Experiments, prototypes, workflows, and ideas moving from an observation into something testable.</p></div>
          <div class="meta">See what is being built</div>
        </a>
        <a class="card" href="/about/">
          <div><div class="kicker">Perspective</div><h3>Life, systems, survival</h3><p>Technology matters most when it meets real life. This is where the personal and operational parts of the story connect.</p></div>
          <div class="meta">About The Ali Unseen</div>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Connect</div>
          <h2>Find The Ali Unseen</h2>
        </div>
      </div>

      <div class="contact-grid">
        <a class="contact-link" href="https://x.com/TheAliUnseen" target="_blank" rel="noreferrer"><strong>X</strong><span>@TheAliUnseen</span></a>
        <a class="contact-link" href="https://www.instagram.com/TheAliUnseen" target="_blank" rel="noreferrer"><strong>Instagram</strong><span>@TheAliUnseen</span></a>
        <a class="contact-link" href="https://substack.com/@thealiunseen" target="_blank" rel="noreferrer"><strong>Substack</strong><span>@thealiunseen</span></a>
        <a class="contact-link" href="https://ko-fi.com/thealiunseen" target="_blank" rel="noreferrer"><strong>Ko-fi</strong><span>thealiunseen</span></a>
        <a class="contact-link" href="mailto:ali@thealiunseen.com"><strong>Email</strong><span>ali@thealiunseen.com</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
