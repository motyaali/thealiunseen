---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not Found" description="That page is not part of The Ali Unseen yet.">
  <section class="hero">
    <div class="container hero-copy">
      <div class="eyebrow">404</div>
      <h1 class="page-title">This one is still unseen.</h1>
      <p class="hero-dek">The page you followed does not exist, moved, or has not been published yet.</p>
      <div class="hero-actions">
        <a class="button primary" href="/">Return home</a>
        <a class="button" href="/writing/">Browse writing</a>
      </div>
    </div>
  </section>
</BaseLayout>
