---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(modules)
  .map((post: any) => ({ ...post.frontmatter, url: post.url }))
  .filter((post) => !post.draft)
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'short', day: 'numeric'
}).format(new Date(date));
---
<BaseLayout title="Writing" description="Essays, reflections, notes, and experiments from The Ali Unseen.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Writing</div>
      <h1 class="page-title">Notes from the space between human and machine.</h1>
      <p class="lede">Essays, reflections, questions, and field notes on AI, technology, systems, learning, creativity, and lived experience.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article-list">
        {posts.length > 0 ? posts.map((post) => (
          <a class="article-item" href={post.url}>
            <time datetime={post.date}>{formatDate(post.date)}</time>
            <div>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
            </div>
          </a>
        )) : <p class="lede">The archive is being prepared.</p>}
      </div>
    </div>
  </section>
</BaseLayout>
